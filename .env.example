# Copia este archivo a .env.local y rellena los valores.

# URL pública del sitio (SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API key de Resend para el formulario de contacto (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de los correos (en desarrollo vale onboarding@resend.dev)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Correo donde recibo los mensajes
CONTACT_TO_EMAIL=daniel.capote2002@gmail.com
